
alphabet = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z']

shift_amount = ""
result = ""
original_text = ""

def encrypt():
    direction = input("Type 'encode' to encrypt, type 'decode' to decrypt: ").lower()
    original_text = input(str("Ingrese el texto: ")).lower()
    shift_amount = int(input("Ingrese el numero de posicion: "))
    letra_acumulada = ""

    for i in original_text:
        result = alphabet.index(i)
        result += shift_amount
        result %= 26
        letra_acumulada += alphabet[result]
    print (letra_acumulada)

