def decrypt():

    #direction = input("Type 'encode' to encrypt, type 'decode' to decrypt: ").lower()
    original_text = input("Type your message: ").lower()
    shift_amount = int(input("Type the shift number: "))

    decifrar=""
    for i in original_text:
        result = alphabet.index (i) #busca
        result -= shift_amount #resta las posiciones
        result %= 26 #obtiene el resto
        decifrar += alphabet [result]
    print(decifrar)

